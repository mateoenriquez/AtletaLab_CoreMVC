{
    "name": "atletalab/admin",
    "description": "Administración MVC de planificación biomecánica y descarga muscular",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-simplexml": "*",
        "cakephp/authentication": "^3.0",
        "cakephp/cakephp": "5.2.*"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^10.5.58"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "autoload-dev": {"psr-4": {"App\\Test\\": "tests/"}},
    "config": {
        "platform": {"php": "8.1.0"},
        "platform-check": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "check": ["@php bin/check.php", "@test"],
        "serve": "@php bin/cake.php server -H 127.0.0.1 -p 8765"
    }
}
